<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Brand Colors -->
    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryDark">#115E59</Color>
    <Color x:Key="PrimaryLight">#14B8A6</Color>
    
    <Color x:Key="Accent">#F59E0B</Color>
    <Color x:Key="AccentDark">#D97706</Color>

    <!-- Theme-aware Background Colors -->
    <Color x:Key="PageBackgroundLight">#F8FAFC</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>

    <Color x:Key="BgLight">#F8FAFC</Color>
    <Color x:Key="BgDark">#0F172A</Color>

    <Color x:Key="CardBgLight">#FFFFFF</Color>
    <Color x:Key="CardBgDark">#1E293B</Color>

    <Color x:Key="CardBorderLight">#E2E8F0</Color>
    <Color x:Key="CardBorderDark">#334155</Color>

    <!-- Theme-aware Text Colors -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>

    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <Color x:Key="TextTertiaryLight">#94A3B8</Color>
    <Color x:Key="TextTertiaryDark">#475569</Color>

    <!-- Theme-aware Entry/Input Colors -->
    <Color x:Key="EntryBgLight">#F1F5F9</Color>
    <Color x:Key="EntryBgDark">#1E293B</Color>

    <Color x:Key="EntryBorderLight">#CBD5E1</Color>
    <Color x:Key="EntryBorderDark">#334155</Color>

    <!-- Theme-aware Chip/Badge Colors -->
    <Color x:Key="ChipBgLight">#E2E8F0</Color>
    <Color x:Key="ChipBgDark">#334155</Color>

    <!-- Semantic Indicators -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Info">#3B82F6</Color>

</ResourceDictionary>
