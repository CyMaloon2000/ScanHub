<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InventoryScanner.ViewModels"
             x:Class="InventoryScanner.Views.SetupPage"
             x:DataType="vm:SetupViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <VerticalStackLayout Spacing="10" VerticalOptions="Center">
            <Label Text="Initial Setup" FontSize="28" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
            <Label Text="Import the building, location, room, and office catalog before signing in."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
        </VerticalStackLayout>

        <Border Grid.Row="1" Style="{StaticResource InventoryCard}" Padding="16" Margin="0,18,0,0">
            <VerticalStackLayout Spacing="12">
                <Label Text="Setup file" FontAttributes="Bold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border StrokeShape="RoundRectangle 8" Stroke="{AppThemeBinding Light={StaticResource EntryBorderLight}, Dark={StaticResource EntryBorderDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource EntryBgLight}, Dark={StaticResource EntryBgDark}}" StrokeThickness="1" Padding="12,10">
                        <Label Text="{Binding SelectedFilePath, TargetNullValue='No file selected'}" LineBreakMode="MiddleTruncation"/>
                    </Border>
                    <Button Grid.Column="1" Text="Browse" Command="{Binding PickFileCommand}" Style="{StaticResource OutlineButton}"/>
                </Grid>
                <Button Text="Import Setup" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}"/>
                <Label Text="{Binding StatusText}" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
