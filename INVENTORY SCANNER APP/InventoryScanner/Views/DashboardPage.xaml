<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InventoryScanner.ViewModels"
             xmlns:models="clr-namespace:InventoryScanner.Models"
             x:Class="InventoryScanner.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="16">
            <Label Text="Audit Overview" Style="{StaticResource TitleHeader}" Margin="0,4"/>

            <Border Style="{StaticResource InventoryCard}" Padding="20"
                    IsVisible="{Binding HasSessions, Converter={StaticResource InverseBoolConverter}}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="Inventory Scanner" FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Label Text="Create your first inventory scan session to start scanning."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding HasSessions}">
                <Border Style="{StaticResource InventoryCard}" Padding="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="System Status" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                            <Label Text="Offline Audit Active" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            <Label Text="{Binding LastUpdatedSummary}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource ChipBgLight}, Dark={StaticResource ChipBgDark}}"
                                StrokeThickness="0" Padding="12,6" VerticalOptions="Center">
                            <Label Text="Offline" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InventoryCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="AUDITED ROOMS" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding TotalSessions}" FontSize="24" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InventoryCard}" Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="TOTAL SCANNED" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding TotalScannedItems}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Success}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InventoryCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="DRAFT" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding DraftSessions}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InventoryCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="IN PROGRESS" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding InProgressSessions}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Info}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InventoryCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="COMPLETED" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding CompletedSessions}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Success}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InventoryCard}" Padding="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ARCHIVED" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                            <Label Text="{Binding ArchivedSessions}" FontSize="20" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource InventoryCard}" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Recent Rooms" FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <CollectionView ItemsSource="{Binding RecentSessions}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:InventorySession">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="2" Padding="0,6">
                                        <Label Text="{Binding DisplayName}" FontSize="13" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1" Text="{Binding ScanCount, StringFormat='{0} scans'}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                        <Label Grid.Row="1" Text="{Binding Status}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding CreatedDate, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextTertiaryLight}, Dark={StaticResource TextTertiaryDark}}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Border Style="{StaticResource InventoryCard}" Padding="16">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="Sync" TextColor="{StaticResource Primary}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalOptions="Center">
                        <Label Text="Offline Validation Mode" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"/>
                        <Label Text="All inventory audit records are saved directly in SQLite local storage. Export from the Sync page anytime."
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
