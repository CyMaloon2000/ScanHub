<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InventoryScanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InventoryScanner.Views"
    Title="Inventory Scanner"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="130" Padding="16" ColumnDefinitions="Auto, *" ColumnSpacing="12"
              BackgroundColor="{StaticResource Primary}">
            <Border StrokeShape="RoundRectangle 25" BackgroundColor="#20FFFFFF" WidthRequest="50" HeightRequest="50" VerticalOptions="Center" StrokeThickness="0">
                <Label Text="IS" TextColor="White" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Inventory Scanner" FontSize="16" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Offline Audit System" FontSize="12" TextColor="#B2DFDB"/>
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <ShellItem Route="Login" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" />
    </ShellItem>

    <ShellItem Route="Setup" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate views:SetupPage}" />
    </ShellItem>

    <FlyoutItem Title="Dashboard" Route="Dashboard">
        <FlyoutItem.Icon>
            <FileImageSource File="dashboard.svg" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:DashboardPage}" Route="DashboardMain"/>
    </FlyoutItem>

    <FlyoutItem Title="Sessions" Route="Sessions">
        <FlyoutItem.Icon>
            <FileImageSource File="sessions.svg" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SessionListPage}" Route="SessionsMain"/>
    </FlyoutItem>

    <FlyoutItem Title="Sync Status" Route="Sync">
        <FlyoutItem.Icon>
            <FileImageSource File="sync.svg" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:ExportImportPage}" Route="SyncMain"/>
    </FlyoutItem>

    <FlyoutItem Title="Settings" Route="Settings">
        <FlyoutItem.Icon>
            <FileImageSource File="settings.svg" />
        </FlyoutItem.Icon>
        <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsMain"/>
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="16" Spacing="8"
                             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
            <BoxView HeightRequest="1.5" BackgroundColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}" Margin="0,0,0,8"/>
            <Button Text="Sign Out"
                    ImageSource="logout.svg"
                    ContentLayout="Left,8"
                    Command="{Binding LogoutCommand}"
                    TextColor="{StaticResource Error}"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    FontSize="14"
                    HorizontalOptions="FillAndExpand"
                    HeightRequest="48"
                    CornerRadius="8"/>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
